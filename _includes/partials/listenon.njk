{% from "partials/brandicon.njk" import brandicon %}
<div class="listen-grid">
  {%- for item in site.listenOn %}
  <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" title="{{ item.name }}" aria-label="{{ item.name }}" style="color: {{ item.color }}">
    {{ brandicon(item.icon) }}
  </a>
  {%- endfor %}
</div>
