{#
  Windowed pagination: first page, a window around the current page, last page,
  with gaps collapsed to an ellipsis. `hrefs` is 0-indexed, `current` is 1-based.
#}
{% macro paginate(hrefs, current) -%}
{%- set total = hrefs.length -%}
{%- if total > 1 -%}
{%- set windowStart = 2 if current - 1 < 2 else current - 1 -%}
{%- set windowEnd = (total - 1) if current + 1 > total - 1 else current + 1 -%}
<ul class="pagination">
  {%- if current > 1 %}
  <li class="page-item"><a href="{{ hrefs[current - 2] }}" aria-label="Previous page">&lsaquo;</a></li>
  {%- endif %}
  <li class="page-item{{ ' active' if current == 1 }}"><a href="{{ hrefs[0] }}">1</a></li>
  {%- if windowStart > 2 %}
  <li class="page-gap"><span>...</span></li>
  {%- endif %}
  {%- for i in range(windowStart, windowEnd + 1) %}
  <li class="page-item{{ ' active' if i == current }}"><a href="{{ hrefs[i - 1] }}">{{ i }}</a></li>
  {%- endfor %}
  {%- if windowEnd < total - 1 %}
  <li class="page-gap"><span>...</span></li>
  {%- endif %}
  <li class="page-item{{ ' active' if current == total }}"><a href="{{ hrefs[total - 1] }}">{{ total }}</a></li>
  {%- if current < total %}
  <li class="page-item"><a href="{{ hrefs[current] }}" aria-label="Next page">&rsaquo;</a></li>
  {%- endif %}
</ul>
{%- endif -%}
{%- endmacro %}
