---
layout: layouts/base.njk
---
<div class="main-inner">
  {%- if listTitle %}
  <div class="page-head">
    {%- if eyebrow %}<div class="page-eyebrow">{{ eyebrow }}</div>{% endif %}
    <h1 class="page-title">{{ listTitle }}</h1>
    {%- if pageSub %}<p class="page-sub">{{ pageSub }}</p>{% endif %}
  </div>
  {%- endif %}
  {{ content | safe }}
</div>
